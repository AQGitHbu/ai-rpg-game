# RPG owns these values. Runtime never reads ai-slg-game/.env.
# For local bootstrap, `npm run env:bootstrap` may seed the same initial values
# from the RPG main checkout or sibling SLG checkout without printing secrets.
AI_API_BASE_URL=https://your-openai-compatible-provider.example/v1
AI_MODEL=replace-me
AI_API_KEY=replace-me

# Optional structured-output mode for scenario generation (Phase 4C).
# One of: json_schema | json_object | prompt_only (default when unset).
# Only set a value your provider explicitly supports; invalid values make the
# AI source unavailable (players still get the deterministic fallback opening).
# AI_OUTPUT_FORMAT=prompt_only

# Persistence settings. GAME_DB_PATH is read only by the server-side
# sqliteClient layer (src/game/application/server/persistence/sqliteClient.ts);
# when unset, the repo-local ignored default db/rpg.sqlite is used.
GAME_PERSISTENCE_BACKEND=sqlite
GAME_DB_PATH=./db/rpg.sqlite

# Operational logs use a separate SQLite database. The server initializes it
# lazily, so logging never blocks game startup. If SQLite cannot be opened,
# structured JSONL falls back to GAME_LOG_FALLBACK_DIR (default: ./logs).
GAME_LOG_DB_PATH=./data/logs.db
# GAME_LOG_FALLBACK_DIR=./logs
# GAME_LOG_MAX_EVENT_BYTES=131072
# Optional operational retention policy. `npm run logs:retention` uses these
# values when command-line flags are not provided.
# GAME_LOG_STANDARD_RETENTION_DAYS=30
# GAME_LOG_AUDIT_RETENTION_DAYS=365
# GAME_LOG_RETENTION_MAX_RUN_MS=30000

# ---------------------------------------------------------------------------
# AI 文本审计（AI_TEXT_AUDIT_*）——默认开启，全部可选。
# 审计日志保存完整 prompt、模型正文、玩家语义输入和最终文本；GAME_API_AUDIT
# 独立控制游戏 API body 的 compact/full/off 记录。
# 唯一保留的安全排除项是 API key、Authorization、cookie 和完整 URL。
# 审计日志不经过普通日志的递归脱敏和 128 KiB 截断，落到独立 JSONL 文件。
# ---------------------------------------------------------------------------
# AI_TEXT_AUDIT=full
# AI_TEXT_AUDIT_DIR=logs/ai-text-audit
# AI_TEXT_AUDIT_RUN_ID=manual-2026-08-20-01
# GAME_API_AUDIT=compact   # compact（默认）/full/off；full 用于轮询问题复现

# Opt-in flag for the Phase 4B real AI smoke (`npm run smoke:ai:phase4b`).
# It triggers real, billable AI calls, so it must be set explicitly in the
# shell for a single run (e.g. PowerShell: $env:RUN_REAL_AI_SMOKE='1').
# Do NOT persist it here or in .env.local; the script only reads process env.
# RUN_REAL_AI_SMOKE=1

# ---------------------------------------------------------------------------
# AI 故事质量评估（STORY_EVAL_*）——全部可选，未设置零影响。
# 两类设置惯例：
# - RUN_REAL_AI_*：只在 shell 中为单次脚本运行设置、不持久化（与 RUN_REAL_AI_JOURNEY 同惯例）；
# - STORY_EVAL_CAPTURE：服务端装配开关——评估旅程由门禁脚本自动传给子进程；浏览器手玩采集
#   需在启动 dev server 的 shell 中临时设置（同样不持久化，避免忘关后 prompt 原文长期落盘）。
# ---------------------------------------------------------------------------
# STORY_EVAL_CAPTURE=1
# STORY_EVAL_ARTIFACT_DIR=artifacts/story-eval/run-example
# RUN_REAL_AI_STORY_EVAL=1
# STORY_EVAL_SEED=20260731
# STORY_EVAL_MAX_SCENES=60
# STORY_EVAL_BLUEPRINT_ARTIFACT=artifacts/story-eval/<run>/calls.jsonl
# RUN_REAL_AI_STORY_EVAL_JUDGE=1
# STORY_EVAL_JUDGE_MODEL=ai-model-name
# Optional provider extended reasoning experiment. Comma-separated roles:
# scenario,director,writer,npc. Unset means enable_thinking=false for all roles.
# AI_THINKING_ROLES=director,writer
# Production RPG role override. Comma-separated roles: intent,opening,scene,world
# plus the staged narrative roles planning,narration,character,choices (Spec
# 2026-09-09). Unset means enable_thinking=false for every production role. Keep
# this separate from AI_THINKING_ROLES, which belongs to story-evaluation tooling.
# AI_RUNTIME_THINKING_ROLES=world
