# RPG owns these values. Runtime never reads ai-slg-game/.env.
# For local bootstrap, `npm run env:bootstrap` may seed the same initial values
# from the RPG main checkout or sibling SLG checkout without printing secrets.
AI_API_BASE_URL=https://your-openai-compatible-provider.example/v1
AI_MODEL=replace-me
AI_API_KEY=replace-me

# Persistence settings. GAME_DB_PATH is read only by the server-side
# sqliteClient layer (src/game/application/server/persistence/sqliteClient.ts);
# when unset, the repo-local ignored default db/rpg.sqlite is used.
GAME_PERSISTENCE_BACKEND=sqlite
GAME_DB_PATH=./db/rpg.sqlite

# Opt-in flag for the Phase 4B real AI smoke (`npm run smoke:ai:phase4b`).
# It triggers real, billable AI calls, so it must be set explicitly in the
# shell for a single run (e.g. PowerShell: $env:RUN_REAL_AI_SMOKE='1').
# Do NOT persist it here or in .env.local; the script only reads process env.
# RUN_REAL_AI_SMOKE=1
