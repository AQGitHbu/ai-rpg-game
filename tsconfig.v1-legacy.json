{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "tsBuildInfoFile": "./.cache/v1-legacy.tsbuildinfo"
  },
  // v1 legacy 链路参考类型检查入口（非门禁）：
  // R1（Task 2）把 narrative.generation 改为 PendingNarrativeJob 结构后，v1
  // 叙事/行动链路产生类型漂移。这些文件已从主 tsconfig 的 typecheck/build 门禁
  // 排除（v2.1 为生产链路），仅作行为参考。本入口用于在需要时单独审阅 v1 类型债
  // （预期会报错，不代表回归）。
  "include": [
    "next-env.d.ts",
    "src/game/application/createGame.ts",
    "src/game/application/getCurrentGame.ts",
    "src/game/application/getOrCreateScene.ts",
    "src/game/application/generatePendingNarrativeScene.ts",
    "src/game/application/handleNpcDialogue.ts",
    "src/game/application/orchestrateNarrativeScene.ts",
    "src/game/application/performAction.ts",
    "src/game/application/runtimeNarrativeContexts.ts",
    "src/game/application/scenarioGeneration.ts",
    "src/game/application/runtimeNarrative.ts",
    "src/game/application/server/compositionRoot.ts",
    "src/game/application/server/ai/runtimeNarrativeTaskCoordinator.ts",
    "src/game/application/index.v1.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
