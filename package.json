{
  "name": "ai-rpg-game",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.5.2",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:boundaries": "vitest run src/dependencyBoundaries.test.ts src/game/logging/dependencyBoundaries.test.ts",
    "test:game-domain": "vitest run src/game/domain",
    "test:game-gameplay": "vitest run src/game/gameplay",
    "test:game-application": "vitest run src/game/application",
    "test:game-logging": "vitest run src/game/logging",
    "test:components": "vitest run src/components",
    "test:app": "vitest run src/app",
    "test:changed": "vitest run --changed",
    "test:related": "vitest related --run",
    "test:shared-ui": "vitest run src/components/sharedUiContract.test.tsx",
    "sync:standards": "node scripts/syncStandards.mjs",
    "check:standards": "node scripts/checkStandards.mjs",
    "shared:lookup": "node scripts/sharedLookup.mjs",
    "shared:check": "node scripts/checkSharedBoundaries.mjs",
    "test:foundation-locator": "node --test scripts/foundationLocator.node-test.mjs",
    "link:foundation": "node scripts/linkFoundation.mjs",
    "bootstrap:foundation": "node scripts/linkFoundation.mjs",
    "test:fast": "npm run check:standards && npm run test:foundation-locator && npm run test:ai-env && npm run test:handoff-check && npm run shared:check && npm run typecheck && npm run test:boundaries",
    "accept": "npm run lint && npm run typecheck && npm test && npm run test:fast && npm run build && npm run phase:status",
    "doctor": "node scripts/doctor.mjs",
    "env:bootstrap": "node scripts/bootstrapAiEnv.mjs",
    "env:check": "node scripts/checkAiEnv.mjs",
    "test:ai-env": "node --test scripts/aiEnv.node-test.mjs",
    "phase:status": "node scripts/checkHandoff.mjs --status",
    "phase:start": "node scripts/startCurrentPhase.mjs",
    "worktree:remove": "node scripts/removeWorktree.mjs",
    "test:worktree-remove": "node --test scripts/removeWorktree.node-test.mjs",
    "test:handoff-check": "node --test scripts/checkHandoff.node-test.mjs",
    "test:phase4b-ai-smoke-script": "node --test scripts/phase4bAiSmoke.node-test.mjs",
    "smoke:ai:phase4b": "node scripts/phase4bAiSmoke.mjs",
    "test:foundation-journey": "vitest run src/game/application/testing/foundationJourney.test.ts",
    "journey:foundation": "node scripts/foundationJourney.mjs --mode=replay",
    "logs:query": "node scripts/logs.mjs query",
    "logs:retention": "node scripts/logs.mjs retention",
    "logs:health": "node scripts/logs.mjs health",
    "test:logs": "node --test scripts/logs.node-test.mjs",
    "handoff:check:docs": "node scripts/checkHandoff.mjs",
    "handoff:check": "node scripts/checkHandoff.mjs --strict-branch",
    "setup": "npm run env:bootstrap && npm run bootstrap:foundation && npm ci && npm run sync:standards && npm run doctor"
  },
  "dependencies": {
    "@ai-game/ai-transport": "file:.foundation/packages/ai-transport",
    "@ai-game/logging": "file:.foundation/packages/logging",
    "@ai-game/ui": "file:.foundation/packages/ui",
    "@libsql/client": "0.17.3",
    "next": "16.2.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "0.0.1",
    "zustand": "5.0.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.29",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "eslint": "9.27.0",
    "eslint-config-next": "16.2.10",
    "jsdom": "29.1.1",
    "typescript": "5.8.3",
    "vitest": "3.1.4"
  }
}
