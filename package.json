{
  "name": "ai-rpg-game",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.5.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:boundaries": "vitest run src/dependencyBoundaries.test.ts",
    "test:shared-ui": "vitest run src/components/sharedUiContract.test.tsx",
    "sync:standards": "node scripts/syncStandards.mjs",
    "check:standards": "node scripts/checkStandards.mjs",
    "shared:lookup": "node scripts/sharedLookup.mjs",
    "shared:check": "node scripts/checkSharedBoundaries.mjs",
    "test:foundation-locator": "node --test scripts/foundationLocator.node-test.mjs",
    "link:foundation": "node scripts/linkFoundation.mjs",
    "bootstrap:foundation": "node scripts/linkFoundation.mjs",
    "test:fast": "npm run check:standards && npm run test:foundation-locator && npm run test:ai-env && npm run shared:check && npm run typecheck && npm run test:boundaries",
    "doctor": "node scripts/doctor.mjs",
    "env:bootstrap": "node scripts/bootstrapAiEnv.mjs",
    "env:check": "node scripts/checkAiEnv.mjs",
    "test:ai-env": "node --test scripts/aiEnv.node-test.mjs",
    "phase:status": "node scripts/checkHandoff.mjs --status",
    "phase:start": "node scripts/startCurrentPhase.mjs",
    "handoff:check:docs": "node scripts/checkHandoff.mjs",
    "handoff:check": "node scripts/checkHandoff.mjs --strict-branch",
    "setup": "npm run env:bootstrap && npm run bootstrap:foundation && npm ci && npm run sync:standards && npm run doctor"
  },
  "dependencies": {
    "@ai-game/ui": "file:.foundation/packages/ui",
    "@libsql/client": "0.17.3",
    "next": "16.2.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zustand": "5.0.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.29",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "eslint": "9.27.0",
    "eslint-config-next": "16.2.10",
    "jsdom": "29.1.1",
    "typescript": "5.8.3",
    "vitest": "3.1.4"
  }
}
